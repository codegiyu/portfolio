{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "node scripts/clean-next-types.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/clean-next-types.mjs && next typegen && tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings=0",
    "fonts:check": "node scripts/check-fonts.mjs",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e/run.mjs",
    "lighthouse:check": "node scripts/lighthouse/run.mjs",
    "config:verify": "node scripts/ops/verify-config.mjs",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "release:check": "npm run format:check && npm run lint && npm run fonts:check && npm run typecheck && npm test && npm run build:check && npm run audit:prod",
    "generate:icons": "npx @svgr/cli --out-dir components/icons --ignore-existing --typescript --replace-attr-values #fff=currentColor,#000=currentColor --jsx-runtime automatic --icon -- public/icons",
    "seed": "tsx scripts/seed.ts",
    "content:backup": "tsx scripts/content/backup.ts",
    "content:migrate": "tsx scripts/content/migrate.ts",
    "content:verify": "tsx scripts/content/verify.ts",
    "analytics:cleanup": "tsx scripts/analytics/cleanup.ts",
    "assets:reconcile": "tsx scripts/assets/reconcile.ts",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:verify": "tsx scripts/firebase/verify-indexes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.0.3",
    "firebase-admin": "14.5.0",
    "fuse.js": "^7.4.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.482.0",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.0.2",
    "uuid": "^14.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@fastify/busboy": "3.2.3",
    "@grpc/grpc-js": "1.14.6",
    "brace-expansion": "2.1.7",
    "js-yaml": "^3.15.1",
    "minimatch": "^9.0.7",
    "glob": "^10.4.6",
    "protobufjs": "^7.6.5",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@iconify/react": "^4.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.13",
    "axe-core": "^4.11.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "8.5.26",
    "prettier": "^3.5.3",
    "tailwind-scrollbar-hide": "^1.1.7",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8"
}

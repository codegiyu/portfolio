    "@radix-ui/react-slot": "^1.2.3",
    "caniuse-lite": "^1.0.30001799",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.0.3",
    "firebase-admin": "^14.0.0",
    "fuse.js": "^7.4.2",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.482.0",
    "next": "^16.2.9",
    "next-seo": "^6.6.0",
    "nodemailer": "^8.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.5",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.0.2",
    "tailwind-scrollbar-hide": "^1.1.7",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "minimatch": "^9.0.7",
    "glob": "^10.4.6"

# Admin auth
ADMIN_EMAIL=your@email.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication requires Firebase Admin configuration at runtime.
# The service-account JSON must remain server-side and must never be committed.

# Nodemailer (Zoho SMTP)
NODEMAILER_EMAIL=your@zoho.com
NODEMAILER_PASSWORD=your-zoho-app-password

# Firebase Admin SDK (server-side only — paste the full service account JSON as a single line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Cloudflare R2 object storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Public URL for your R2 bucket (configure in Cloudflare dashboard → R2 → Public Access)
R2_PUBLIC_URL=https://your-bucket.your-domain.com

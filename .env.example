# Codegiyu Portfolio environment variables
#
# Copy this file to .env.local for local development. Keep real credentials out
# of Git. Values below are examples/placeholders; replace them before use.

# -----------------------------------------------------------------------------
# Required server configuration
# -----------------------------------------------------------------------------

# Admin email allowed to request magic links and receive contact submissions.
# Must be a valid email address.
# ADMIN_EMAIL=admin@example.com

# Canonical site origin. Use http://localhost:3000 locally and an HTTPS origin
# in production. Do not include query strings, fragments, or credentials.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Admin service account JSON, kept server-side only. Paste the complete
# JSON object as one line; never expose this through NEXT_PUBLIC_* variables.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","client_email":"firebase-adminsdk@example.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# -----------------------------------------------------------------------------
# SMTP / email delivery
# -----------------------------------------------------------------------------

# Zoho (or another SMTP provider) credentials used for magic links and contact
# delivery. NODEMAILER_HOST, NODEMAILER_PORT, and NODEMAILER_SECURE have safe
# Zoho defaults but are shown here so deployments can configure them explicitly.
# NODEMAILER_EMAIL=your@zoho.com
# NODEMAILER_PASSWORD=your-zoho-app-password
# NODEMAILER_HOST=smtp.zoho.com
# NODEMAILER_PORT=465
# NODEMAILER_SECURE=true

# -----------------------------------------------------------------------------
# Cloudflare R2 uploads
# -----------------------------------------------------------------------------

# Required only when using the authenticated admin upload flow.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=your-bucket-name
# Public HTTPS origin for uploaded assets; do not use the private endpoint.
# R2_PUBLIC_URL=https://static.example.com

# -----------------------------------------------------------------------------
# Content operations and local fixtures
# -----------------------------------------------------------------------------

# Development-only fallback for missing Firestore settings. Keep false in
# production; production must read authoritative content from Firestore.
# CONTENT_FIXTURE_MODE=false

# Temporarily blocks admin content mutations during backup/deploy windows.
# Set in the deployed environment, not just in a local shell, when freezing
# production writes. The migration CLI itself still requires explicit --apply.
# CONTENT_WRITES_FROZEN=false

# Secret token that authorises the POST /api/revalidate endpoint used by the
# seed script's --revalidate flag to purge the Next.js Data Cache immediately
# after a seed run. Set the same value in both .env.local and your Vercel
# environment variables. Generate with: openssl rand -base64 32
# REVALIDATE_SECRET=your-secret-here

# -----------------------------------------------------------------------------
# Browser/E2E validation
# -----------------------------------------------------------------------------

# Required by npm run test:e2e. Point only to an isolated preview, emulator, or
# dedicated non-production project; never use production credentials/data.
# E2E_BASE_URL=https://preview.example.com

# Set to true when E2E_BASE_URL is a preview deployment so the suite asserts
# noindex behavior. Leave false for local/emulator runs.
# E2E_EXPECT_PREVIEW=false

# Optional Lighthouse CI target. The performance job fails if this is absent;
# use an isolated Vercel preview or another non-production URL.
# LIGHTHOUSE_URL=https://preview.example.com

# -----------------------------------------------------------------------------
# Hosting/runtime variables supplied by the platform
# -----------------------------------------------------------------------------

# Vercel supplies these automatically; do not create secrets for them:
# VERCEL_ENV=development|preview|production
# VERCEL_URL=generated-preview-hostname.vercel.app
# VERCEL=1

# Next.js and GitHub Actions supply these automatically:
# NODE_ENV=development|test|production
# CI=true
